{
  "name": "draftline",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome extension: watch any web page draw itself as a blueprint.",
  "type": "module",
  "scripts": {
    "check": "node --check extension/draftline.js && node --check extension/background.js",
    "lint": "eslint extension tests scripts",
    "test": "node tests/smoke.mjs demo/index.html",
    "test:site": "node tests/smoke.mjs https://cenovabuild.com/",
    "test:ext": "node tests/extension.mjs demo/index.html",
    "assets": "node scripts/make-assets.mjs",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "puppeteer-core": "25.16.0"
  }
}
